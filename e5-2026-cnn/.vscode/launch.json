{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "API - Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8081"
            ],
            "cwd": "${workspaceFolder}/api",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": true
        }
    ]
}
